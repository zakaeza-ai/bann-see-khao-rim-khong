# คัดลอกไฟล์นี้เป็น .env.local (สำหรับ dev) และตั้งค่าเดียวกันใน Vercel Environment Variables (สำหรับ deploy จริง)

# ดูค่าได้จาก Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ใช้เฉพาะฝั่ง server (Edge Functions / Route Handlers) ห้าม expose ฝั่ง client เด็ดขาด
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ลิงก์ LINE OA สำหรับปุ่ม "แอดไลน์เพื่อจอง" (ใช้รูปแบบ https://line.me/R/ti/p/@your-line-id)
NEXT_PUBLIC_LINE_OA_URL=https://line.me/R/ti/p/@baansikhaorimkhong

# LINE ID ของ OA (เช่น @baansikhaorimkhong) — ถ้าตั้งค่านี้ ปุ่มจองจากปฏิทินจะพิมพ์ข้อความ
# "สนใจจองห้อง X เช็คอิน...เช็คเอาท์..." ให้ลูกค้าอัตโนมัติตอนเปิด LINE
NEXT_PUBLIC_LINE_OA_ID=@baansikhaorimkhong

# เบอร์โทรติดต่อที่แสดงหน้าเว็บ
NEXT_PUBLIC_CONTACT_PHONE=042-xxxxxx
